#!/usr/bin/env bash
# Installs and configures nginx on an Ubuntu machine so that a GET
# request to / returns a page containing "Holberton School"

# Update package lists and install nginx non-interactively
sudo apt-get update -y
sudo apt-get install -y nginx

# Create the index page nginx will serve at the root
echo "Holberton School for the win!" > /var/www/html/index.html

# Make sure nginx is enabled
sudo service nginx start

exit 0
