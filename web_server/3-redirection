#!/usr/bin/env bash
# Configures a fresh Ubuntu machine so that Nginx is installed and
# /redirect_me returns a 301 redirect to a YouTube video.

# Avoid interactive prompts (e.g. service restart dialogs) during install
export DEBIAN_FRONTEND=noninteractive

# Update package list and install nginx
apt-get update -y
apt-get install -y nginx

# Make sure the server is running before we edit config
service nginx start

CONFIG="/etc/nginx/sites-available/default"

# Insert the redirect rule right after the "listen" line inside the
# default server block, unless it's already there.
if ! grep -q "location /redirect_me" "$CONFIG"; then
  awk '/listen 80 default_server;/{
    print;
    print "\tlocation /redirect_me {";
    print "\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;";
    print "\t}";
    next
  }1' "$CONFIG" > /tmp/nginx_default.tmp
  mv /tmp/nginx_default.tmp "$CONFIG"
fi

# Restart nginx to apply the new configuration
service nginx restart

exit 0
